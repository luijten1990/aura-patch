STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend
# Stripe payment provider. Keep these server-only values out of the storefront.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Brevo transactional email. The sender must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Aura Patch
# Comma-separated inboxes to receive internal new-order notifications.
BREVO_NEW_ORDER_RECIPIENTS=

# USPS domestic labels. Start with the TEM endpoint, then switch to production
# after a successful watermarked-label test.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
USPS_CRID=
USPS_MID=
USPS_PAYMENT_ACCOUNT_NUMBER=
USPS_PAYMENT_ACCOUNT_TYPE=EPS
# Required only when USPS_PAYMENT_ACCOUNT_TYPE=PERMIT.
USPS_PERMIT_ZIP_CODE=
USPS_API_BASE_URL=https://apis-tem.usps.com
USPS_MAIL_CLASS=PRIORITY_MAIL
USPS_RATE_INDICATOR=SP
USPS_DEFAULT_WEIGHT_OZ=3
USPS_DEFAULT_LENGTH_IN=8.3
USPS_DEFAULT_WIDTH_IN=5.8
USPS_DEFAULT_HEIGHT_IN=0.25
USPS_LABEL_EMAIL_TO=orders@getaurapatch.com

# Easyship international checkout and labels. The API token needs Rate,
# Shipment, Label, and Shipment Document scopes.
EASYSHIP_API_TOKEN=
# Optional override. Sandbox tokens use the sandbox API automatically.
EASYSHIP_API_BASE_URL=
EASYSHIP_ITEM_DESCRIPTION=Vitamin patch
EASYSHIP_ITEM_VALUE_USD=49.99
# Supplier-provided HS code. Use digits-only for the API.
EASYSHIP_ITEM_HS_CODE=3005109000
EASYSHIP_PACKAGE_WEIGHT_OZ=3
EASYSHIP_PACKAGE_LENGTH_IN=8.3
EASYSHIP_PACKAGE_WIDTH_IN=5.8
EASYSHIP_PACKAGE_HEIGHT_IN=0.25

# Create a carrier label as soon as a paid order is placed. Keep false until
# both carrier accounts and their shipping options have passed sandbox tests.
AUTO_FULFILL_ON_ORDER_PAID=false
