BREVO_NEW_ORDER_RECIPIENTS=

# EasyPost checkout quotes and labels. Use a test key (EZTEST...) until a
# live rate and label have succeeded.
EASYPOST_API_KEY=
EASYPOST_API_BASE_URL=https://api.easypost.com/v2
EASYPOST_ITEM_DESCRIPTION=Vitamin patch
EASYPOST_ITEM_VALUE_USD=49.99
EASYPOST_ITEM_HS_CODE=3005109000
EASYPOST_CUSTOMS_SIGNER=Aura Patch
EASYPOST_PACKAGE_WEIGHT_OZ=3
EASYPOST_PACKAGE_LENGTH_IN=8.3
EASYPOST_PACKAGE_WIDTH_IN=5.8
EASYPOST_PACKAGE_HEIGHT_IN=0.25
EASYPOST_LABEL_EMAIL_TO=orders@getaurapatch.com
# Optional warehouse fallbacks when the stock location address is incomplete.
EASYPOST_ORIGIN_NAME=Aura Patch
EASYPOST_ORIGIN_PHONE=
EASYPOST_ORIGIN_EMAIL=
EASYPOST_ORIGIN_STREET=
EASYPOST_ORIGIN_CITY=
EASYPOST_ORIGIN_STATE=
EASYPOST_ORIGIN_ZIP=
